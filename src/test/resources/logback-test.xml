<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender for test output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger configuration for tests -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

    <!-- Reduce verbosity for third-party libraries -->
    <logger name="org.apache.maven" level="WARN" />
    <logger name="org.eclipse.aether" level="WARN" />
    <logger name="com.sun.jna" level="WARN" />

    <!-- Keep our library logging at INFO level -->
    <logger name="com.faster.affinity" level="INFO" />
</configuration>